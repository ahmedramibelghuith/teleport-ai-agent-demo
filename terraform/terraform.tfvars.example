# Copy to terraform.tfvars and fill in your domain.
# REQUIRED:
domain_name = "example.com"      # <-- the domain you own at your registrar
subdomain   = "teleport-demo"    # final URL = teleport-demo.example.com

# Deployment-specific settings (required):
vpc_id         = "vpc-0123456789abcdef0"
key_name       = "your-ec2-key-pair"
ssh_cidr       = "192.0.2.1/32" # Replace with your admin IP/CIDR.
teleport_proxy = "your-tenant.teleport.sh:443"

# Optional overrides (defaults shown):
# region           = "ap-south-1"
# instance_type    = "t3.small"
# bedrock_model_id = "global.anthropic.claude-opus-4-5-20251101-v1:0"
